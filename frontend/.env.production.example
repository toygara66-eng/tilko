# `next build` bu dosyayı okur; APK içine gömülür.
# Kopyala:  copy .env.production.example .env.production
# Canlı FastAPI adresi (https, sonda / yok)

NEXT_PUBLIC_API_BASE=https://tilko-api.onrender.com
# Google Identity Services (Web Client ID) — /giris butonu
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# false = webde sandbox ödeme kapalı; Pro sadece Android Play Billing
NEXT_PUBLIC_PLAY_BILLING_SANDBOX=true
