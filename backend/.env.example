# OpenAI (GPT-4o) — en az bir sağlayıcı doldurulmalı
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini (opsiyonel alternatif)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Hugging Face Inference Providers (huggingface.co/settings/tokens)
HF_API_KEY=
HF_MODEL=openai/gpt-oss-120b

# Nebius Token Factory (tokenfactory.nebius.com) — birincil
NEBIUS_API_KEY=
NEBIUS_MODEL=google/gemma-3-27b-it
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Groq (console.groq.com/keys) — yedek, kart yok
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Cerebras (cloud.cerebras.ai) — yedek, kart yok, günde ~1M jeton
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gemma-4-31b

# OpenRouter — analizde kullanılmaz (402 fatura)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free

# Yerel model (ücretsiz, kota yok). Önce: ollama pull gemma2:9b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma2:9b
OLLAMA_NUM_CTX=8192

# nebius | cerebras | groq
LLM_PROVIDER=nebius
# Kota/kredi bitince yedek
LLM_FALLBACK=cerebras

APP_HOST=0.0.0.0
APP_PORT=8000

# true yapilirsa her LLM istek/yaniti training/data/raw altina kaydedilir
# (kendi modelini egitmek icin veri toplar; bkz. training/README.md)
CAPTURE_TRAINING_DATA=false

JWT_SECRET=tilko-dev-jwt-change-me
JWT_EXPIRE_HOURS=168
# production ortamında JWT_SECRET en az 32 karakter olmalı, varsayılan yasak
APP_ENV=development

# Google Play Billing — yerelde sandbox=true (test token ile Pro açılır)
# Üretimde PLAY_BILLING_SANDBOX=false ve servis hesabı JSON yolu zorunlu.
PLAY_PACKAGE_NAME=com.tilko.app
PLAY_BILLING_SANDBOX=true
PLAY_WEBHOOK_SECRET=
PLAY_SERVICE_ACCOUNT_FILE=

# Admin RAG tetikleyici — POST /admin/feed-osym-archives
ADMIN_API_SECRET=tilko-admin-dev

# Virgülle ayır. Capacitor Android origin: https://localhost
# Üretim örneği: CORS_ORIGINS=https://localhost,https://tilko.app,https://tilko.vercel.app
CORS_ORIGINS=*

# Render kalıcı disk: DATABASE_PATH=/var/data/kpss.db
DATABASE_PATH=

# Opsiyonel: youtube-transcript.io profil API jetonu (Basic). Yoksa site linkinden yapıştırılır.
# https://www.youtube-transcript.io/api
YOUTUBE_TRANSCRIPT_IO_TOKEN=

# ElevenLabs sesli koç (elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
